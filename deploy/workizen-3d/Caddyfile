# --- Portal (Laravel) --- khôi phục 2026-08-07 sau khi mất trong đợt gộp hạ tầng
portal.workizen.net {
    encode zstd gzip
    header -Server
    header -X-Powered-By
    reverse_proxy portal-web:80 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote_host}
    }
}
