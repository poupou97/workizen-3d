www.workizen.net {
    redir https://workizen.net{uri} permanent
}

# origin.workizen.net is the CloudFront origin — never redirect, serve directly
# CloudFront → origin.workizen.net → app:3000
workizen.net, origin.workizen.net {
    encode zstd gzip

    header -Server
    header -X-Powered-By

    # Redirect www even if CloudFront forwards Host: www.workizen.net to this block
    @www_host host www.workizen.net
    redir @www_host https://workizen.net{uri} permanent

    reverse_proxy app:3000
}

# --- Phase Identity: Keycloak ---
# PUBLIC auth endpoint (founder decision). Not indexed. No basic_auth (would break OIDC).
identity.workizen.net {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle /robots.txt {
        respond "User-agent: *
Disallow: /
" 200
    }
    handle {
        reverse_proxy observer-keycloak:8080 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# --- Grafana --- HOTFIX-SECURITY-002B: noindex + basic_auth (temporary; migrate to IP allowlist/SSO later).
# basic_auth gates the public edge; Keycloak SSO still completes inside (browser carries creds on callback).
grafana.workizen.net {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle /robots.txt {
        respond "User-agent: *
Disallow: /
" 200
    }
    handle {
        basic_auth {
            ops $2a$14$P7VjhSpV.kEgFZhwKGprMeUC.F3FSzk2S7dSaR/voC6IR0SJuBD36
        }
        reverse_proxy observer-grafana:3000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

